# ============================================================================
# Observability stack environment
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================================

# --- Langfuse container ----------------------------------------------------
LANGFUSE_SALT=change-me-to-a-random-string
# NextAuth session secret (any random string for dev)
NEXTAUTH_SECRET=change-me-to-another-random-string

# Database URL used by the Langfuse container (internal compose network)
DATABASE_URL=postgresql://langfuse:langfuse@postgres:5432/langfuse

# Direct database connection from host tools (optional, not used by compose)
DATABASE_HOST_URL=postgresql://langfuse:langfuse@localhost:5432/langfuse

# Initial admin user created on first boot
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me-admin-password
LANGFUSE_INIT_PROJECT_NAME=agent-obs

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Langfuse API keys (created in Langfuse UI, see README.md) --------------
# Used by the OTel Collector Basic Auth and later by the SDK exporter.
# Copy public/secret keys from the project settings page in Langfuse UI.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# Public host of Langfuse UI / API from the host machine (or within compose)
LANGFUSE_HOST=http://localhost:3000

# --- OTel Collector ----------------------------------------------------------
# Tail sampling policy parameters (used by the collector config, P20).
# Порог для cost.over_budget вычисляется SDK по той же переменной.
TAIL_SAMPLER_COST_THRESHOLD=0.05
# Percent (0-100): доля обычных трейсов, сохраняемая sampler'ом (default 10%).
TAIL_SAMPLER_NORMAL_RATE=10

# --- SDK (used later by agent_obs, not by compose itself) --------------------
AGENT_OBS_ENABLED=true
# Deterministic content sampling (P22): percent of traces keeping full text.
AGENT_OBS_CONTENT_RATE=10
# Read Langfuse credentials from env (P19). Set to 1 to fail fast on missing
# config, 0 to degrade to the stdout exporter with a warning.
AGENT_OBS_FAIL_ON_CONFIG=1
# Optional path to a CA bundle to trust self-signed TLS certs (P19).
# TLS verification is always enabled; there is no way to disable it.
# AGENT_OBS_TLS_CA=/certs/langfuse-ca.pem