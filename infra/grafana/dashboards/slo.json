          },
          "targets": [
            {
              "refId": "A",
              "expr": "slo_error_budget_remaining{name=\"latency_p95\"}",
              "legendFormat": "remaining",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "editorMode": "code",
              "range": true
            }
          ]
        },
        {
          "id": 23,
          "type": "table",
          "title": "latency_p95: degradation traces (slow root spans)",
          "description": "Drill-down detail-view: root spans (span_type='agent.loop') slower than the SLI good threshold (3 seconds) in the selected time range - the traces that burn the latency budget. Click a trace_id to open the trace-viewer on that trace; click a timestamp to open it at that moment.",
          "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
