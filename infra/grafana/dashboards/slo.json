              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "slo_burn_rate{name=\"latency_p95\",window=\"5m\"}",
              "legendFormat": "5m (short)",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
