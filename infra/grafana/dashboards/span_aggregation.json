  "panels": [
    {
      "datasource": "prometheus",
      "description": "Ratio of aggregated spans to micro-spans input. Expected range: 0.02–0.05 (1 aggregate per 20–50 micro-spans). If ratio > 0.2, buffer flushes too frequently.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 0.2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "aggregation_ratio",
          "legendFormat": "{{agent_id}}",
          "refId": "A"
        }
      ],
      "title": "Aggregation Ratio",
      "type": "gauge"
    },
