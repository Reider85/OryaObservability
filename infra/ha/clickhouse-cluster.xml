<?xml version="1.0"?>
<clickhouse>
    <remote_servers>
        <observability_cluster>
            <shard>
                <replica>
                    <host>clickhouse1</host>
                    <port>9000</port>
                    <!-- inter-server creds: no default user exists in this image setup, -->
                    <!-- so replicas must authenticate explicitly (compose defaults) -->
                    <user>clickhouse</user>
                    <password>clickhouse</password>
                </replica>
                <replica>
                    <host>clickhouse2</host>
                    <port>9000</port>
                    <!-- inter-server creds: no default user exists in this image setup, -->
                    <!-- so replicas must authenticate explicitly (compose defaults) -->
                    <user>clickhouse</user>
                    <password>clickhouse</password>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>clickhouse3</host>
                    <port>9000</port>
                    <!-- inter-server creds: no default user exists in this image setup, -->
                    <!-- so replicas must authenticate explicitly (compose defaults) -->
                    <user>clickhouse</user>
                    <password>clickhouse</password>
                </replica>
                <replica>
                    <host>clickhouse4</host>
                    <port>9000</port>
                    <!-- inter-server creds: no default user exists in this image setup, -->
                    <!-- so replicas must authenticate explicitly (compose defaults) -->
                    <user>clickhouse</user>
                    <password>clickhouse</password>
                </replica>
            </shard>
        </observability_cluster>
    </remote_servers>

    <!-- NOTE (PP35): no <keeper_server> here — this file is mounted into every
         clickhouse-server (config.d/cluster.xml). An embedded keeper block would
         start a conflicting Keeper on each CH node with a duplicate raft id.
         Keeper runs ONLY in the dedicated clickhouse-keeper{1,2,3} services
         (keeper{1,2,3}.xml, unique server_id per node). The <zookeeper> section
         below is the CLIENT config pointing at the keeper quorum. -->
    <zookeeper>
        <node>
            <host>clickhouse-keeper1</host>
            <port>9181</port>
        </node>
        <node>
            <host>clickhouse-keeper2</host>
            <port>9181</port>
        </node>
        <node>
            <host>clickhouse-keeper3</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- NB (PP35): no <network> section here — clickhouse-server 26.x rejects
         it as UNKNOWN_ELEMENT_IN_CONFIG (the same pre-PP35 bug class as the
         logger level). Tune timeouts via <max_...>/server settings instead. -->

    <logger>
        <!-- "information" is the valid Poco level name; "info" aborts the
             server start on clickhouse/clickhouse-server 26.x (pre-PP35 bug,
             same fix as infra/storage/clickhouse_cluster.xml). -->
        <level>information</level>
        <console>true</console>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
    </logger>
</clickhouse>