<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/operations/settings/settings_users/> -->
  <!--
    App user for host-run SDK tools (HotStore, drift detector, phoenix export).
    Defined via config (same pattern as the image's clickhouse user) because
    the compose-provisioned `clickhouse` account has no CREATE USER grant.
    Mounted into clickhouse:/etc/clickhouse-server/users.d/ and picked up on
    server start or SYSTEM RELOAD CONFIG (clickhouse-init runs the reload).
  -->
  <users>
    <observability_user>
      <password><![CDATA[observability_password]]></password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <!-- PP35: table grants live HERE, not in SQL. The provisioning accounts
           (image-created `clickhouse`, XML `observability_user` itself) were
           granted their privileges WITHOUT GRANT OPTION, so
           `GRANT ... TO observability_user` in clickhouse_ddl_ha.sql fails with
           ACCESS_DENIED (497) on every fresh cluster. Config-defined grants are
           applied directly on SYSTEM RELOAD CONFIG — no SQL grant chain needed.
           observability.* keeps pace with new tables (spans_hot, eval_results,
           audit_events, tree_summaries, span_embeddings, drift_history,
           compliance_catalog, eval_golden_results + views).
           NB: each element is a full GRANT query without grantees, and the
           <grants> block may not coexist with an explicit <access_management>
           element (default 0 anyway — access_management is simply omitted). -->
      <grants>
        <query>GRANT SELECT, INSERT, ALTER ON observability.*</query>
      </grants>
    </observability_user>
  </users>
</clickhouse>
