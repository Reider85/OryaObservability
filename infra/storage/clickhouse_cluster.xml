<?xml version="1.0"?>
<clickhouse>
    <remote_servers>
        <observability_cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>clickhouse2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </observability_cluster>
    </remote_servers>

    <!-- No <zookeeper> section: the compose stack ships no keeper, and the
         DDL worker aborts the server start when it cannot reach one. -->

    <logger>
        <!-- "information" is the valid Poco level name; "info" aborts the
             server start on clickhouse/clickhouse-server 26.x. -->
        <level>information</level>
        <console>true</console>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
    </logger>
</clickhouse>